---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const puzzles = await getCollection('puzzles');
const books = await getCollection('books');
---

<Layout title="Puzzles">
  <article class="space-y-6">
    <header>
      <h1 class="text-4xl font-bold">Puzzles</h1>
      <!-- <p class="mt-2 text-lg text-gray-300">
        ??
      </p> -->
    </header>

    <ul class="space-y-6 list-none p-0 m-0">
      {
        books.map((book) => {
          const bookPuzzles = puzzles
            .filter((puz) => puz.data.collection === book.data.id)
            .sort((puzA, puzB) => puzA.data.problem - puzB.data.problem);

          return (
            <li class="ml-4">
              <p class="mb-2 text-xl font-semibold text-blue-100">
                <i>{book.data.title}</i>, {book.data.author}
              </p>
              <ul class="space-y-1 list-none p-0 m-0 ml-4">
                {bookPuzzles.map((puz) => (
                  <li>
                    <a
                      href={`/solve/${puz.data.collection}/${puz.data.problem}`}
                      class="cool-link text-lg"
                    >
                      {puz.data.problem}. {puz.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>
