---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const puzzles = await getCollection('puzzles');
  const solves = await getCollection('solves');
  const books = await getCollection('books');
  return puzzles.map((puzzle) => ({
    params: {
      collection: puzzle.data.collection,
      problem: String(puzzle.data.problem),
    },
    props: {
      puzzle,
      solve: solves.find(
        (p) =>
          p.data.collection === puzzle.data.collection &&
          p.data.problem === puzzle.data.problem
      ),
      book: books.find(
        (b) => b.data.id == puzzle.data.collection
      )
    },
  }));
}

const { solve, puzzle, book } = Astro.props;

const { Content: PuzzleContent } = await render(puzzle);
const renderedSolve = solve ? await render(solve) : null;
const SolveContent = renderedSolve?.Content;
const formattedSolveDate = solve
  ? new Date(solve.data.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<Layout title={puzzle.data.title}>
  <article class="space-y-8">
    <header class="border-b border-blue-500/15 pb-5">
      <h1 class="text-4xl font-bold text-blue-50">{puzzle.data.title}</h1>
      <p class="mt-3 text-sm text-gray-400"><i>{book?.data.title}</i></p>
      {formattedSolveDate && (
        <p class="mt-3 text-sm text-gray-400">Solved {formattedSolveDate}</p>
      )}
    </header>

    <section
      class="prose prose-invert prose-lg max-w-none
      [&_a]:cool-link
      [&_p]:leading-relaxed
      [&_ul]:list-disc [&_ul]:pl-6
      [&_ol]:list-decimal [&_ol]:pl-6
      [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:mb-3
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-2
      [&_img]:mx-auto [&_img]:w-4/5 [&_img]:py-2
      [&_pre]:bg-transparent [&_pre]:p-0 [&_pre]:my-4
      [&_pre_code]:bg-gray-800 [&_pre_code]:block [&_pre_code]:rounded-lg [&_pre_code]:p-4 [&_pre_code]:overflow-x-auto"
    >
      <i><PuzzleContent /></i>
    </section>

    {SolveContent && (
      <section class="border-t border-blue-500/10 pt-6">
        <h2 class="mb-4 text-2xl font-bold">My solution</h2>

        <div
          class="prose prose-invert prose-lg max-w-none
          [&_a]:cool-link
          [&_p]:leading-relaxed
          [&_ul]:list-disc [&_ul]:pl-6
          [&_ol]:list-decimal [&_ol]:pl-6
          [&_pre]:bg-transparent [&_pre]:p-0 [&_pre]:my-4
          [&_pre_code]:bg-gray-800 [&_pre_code]:block [&_pre_code]:rounded-lg [&_pre_code]:p-4 [&_pre_code]:overflow-x-auto"
        >
          <SolveContent />
        </div>
      </section>
    )}
  </article>
</Layout>
